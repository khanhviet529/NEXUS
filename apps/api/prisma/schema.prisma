/// [OPT] Hạn mức duyệt — BẢNG RIÊNG, tuyệt đối KHÔNG trên tenant_memberships
/// (§12 #62). Fail-closed: không khớp dòng nào = KHÔNG duyệt.
/// CHECK num_nonnulls(membership,role,org_unit) >= 1 nằm ở migration (DDL tay).
/// Tenancy: TENANT · Base: Tenant · +SoftDelete · Audit: trigger
model ApprovalAuthority {
  // [TenantAuditedBase]
  id          String   @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  // [+SoftDelete]
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  documentType  String    @map("document_type") // 'ORDER'…
  currency      String    @default("VND")
  membershipId  String?   @map("membership_id") @db.Uuid
  roleId        String?   @map("role_id") @db.Uuid
  orgUnitId     String?   @map("org_unit_id") @db.Uuid
  minAmount     Decimal   @default(0) @map("min_amount") @db.Decimal(18, 2)
