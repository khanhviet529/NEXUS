/// Tenancy: TENANT · APPEND-ONLY: không UPDATE, không DELETE — sửa sai bằng
/// bút toán đảo (reversal_of cặp 2 cột #30). PK (id, created_at) do partition
model Movement {
  id        String   @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  tenantId  String   @map("tenant_id") @db.Uuid

  accountType         String    @map("account_type") // STOCK | RECEIVABLE | CASH
  accountKey          String    @map("account_key") // warehouseId:productId:lotId
  movementType        String    @map("movement_type") // RECEIPT | ISSUE | ADJUST | REVERSAL
  direction           Int       @db.SmallInt // +1 / -1
  quantity            Decimal   @db.Decimal(18, 3)
  amount              Decimal?  @db.Decimal(18, 2)
  currency            String?
  refType             String    @map("ref_type")
  refId               String    @map("ref_id") @db.Uuid
  reversalOfId        String?   @map("reversal_of_id") @db.Uuid
  reversalOfCreatedAt DateTime? @map("reversal_of_created_at") @db.Timestamptz
  createdById         String?   @map("created_by_id") @db.Uuid

  @@id([id, createdAt])
  @@index([tenantId, accountType, accountKey, createdAt])
  @@map("movements")
}

/// Tenancy: TENANT · KHÔNG partition — nơi thực thi tính duy nhất của movement
/// (unique trên bảng partition phải chứa khoá partition → bất khả thi, #28).
