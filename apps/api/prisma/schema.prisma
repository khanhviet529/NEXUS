  movementCreatedAt DateTime @map("movement_created_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([tenantId, refType, refId, movementType])
  @@map("movement_dedup_keys")
}

