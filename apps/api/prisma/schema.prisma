/// [OPT ưu tiên cao] Webhook outgoing (§5C.5) — secret MÃ HOÁ tầng ứng dụng
/// (§4.11, §12 #35), rotation giữ secret cũ hiệu lực song song.
/// Tenancy: TENANT · Base: Tenant · Audit: trigger
model WebhookEndpoint {
  // [TenantAuditedBase]
  id          String   @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid

  url             String
  secret          String // AES-256-GCM, API KHÔNG BAO GIỜ trả (§4.11)
  secretPrevious  String?   @map("secret_previous")
  secretRotatedAt DateTime? @map("secret_rotated_at") @db.Timestamptz
  status          String    @default("ACTIVE") // ACTIVE | DISABLED
  failureCount    Int       @default(0) @map("failure_count")
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz

  subscriptions WebhookSubscription[]
  deliveries    WebhookDelivery[]

  @@unique([tenantId, id]) // đích composite FK (§6.4)
  @@map("webhook_endpoints")
}

/// Tenancy: TENANT · Base: Tenant
model WebhookSubscription {
  // [TenantAuditedBase]
  id          String   @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid

  endpointId String @map("endpoint_id") @db.Uuid
  eventType  String @map("event_type")

  endpoint WebhookEndpoint @relation(fields: [tenantId, endpointId], references: [tenantId, id])

  @@unique([tenantId, endpointId, eventType])
  @@map("webhook_subscriptions")
}

/// Delivery log — UNIQUE (tenant, endpoint, event) chống gửi trùng (§8.2 outbox note)
/// Tenancy: TENANT · Base: Tenant
model WebhookDelivery {
  // [TenantAuditedBase]
  id          String   @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid

  endpointId     String    @map("endpoint_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  eventType      String    @map("event_type")
  payload        Json
  status         String    @default("PENDING") // PENDING | DELIVERED | FAILED | DISABLED
  responseStatus Int?      @map("response_status")
  attempts       Int       @default(0)
  nextRetryAt    DateTime? @map("next_retry_at") @db.Timestamptz
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz

  endpoint WebhookEndpoint @relation(fields: [tenantId, endpointId], references: [tenantId, id])

  @@unique([tenantId, endpointId, eventId])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

