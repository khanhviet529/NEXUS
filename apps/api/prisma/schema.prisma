  updatedById String?  @map("updated_by_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid

  fileId   String  @map("file_id") @db.Uuid
  entity   String // EntityType (packages/shared) — không phải chuỗi tự do
  entityId String  @map("entity_id") @db.Uuid
  category String?

  file File @relation(fields: [tenantId, fileId], references: [tenantId, id])

  @@index([tenantId, entity, entityId])
  @@index([tenantId, fileId])
  @@map("attachments")
}

/// [CORE nhẹ] Sở thích nhận thông báo — theo MEMBERSHIP (erd.md #1).
/// Tenancy: TENANT · Base: Tenant
model NotificationPreference {
  // [TenantAuditedBase]
  id          String   @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid

  membershipId String   @map("membership_id") @db.Uuid
  type         String // NotificationType (packages/shared)
  channels     String[] // 'IN_APP' | 'EMAIL'

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id])

  @@unique([tenantId, membershipId, type])
  @@map("notification_preferences")
}

/// [CORE nhẹ] Business calendar (§5C.4) — "ngày làm việc" dùng khắp nơi.
/// Tenancy: TENANT · Base: Tenant · một lịch mặc định mỗi tenant (partial unique, DDL tay)
model BusinessCalendar {
  // [TenantAuditedBase]
  id          String   @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid

  name      String
  timezone  String  @default("Asia/Ho_Chi_Minh")
  isDefault Boolean @default(false) @map("is_default")

  workingHours CalendarWorkingHour[]
  holidays     CalendarHoliday[]

  @@unique([tenantId, id]) // đích composite FK (§6.4)
  @@map("business_calendars")
}

/// Giờ làm việc theo thứ — dayOfWeek ISO-8601: 1=Thứ 2 … 7=Chủ nhật.
/// Tenancy: TENANT · Base: Tenant
model CalendarWorkingHour {
  // [TenantAuditedBase]
  id          String   @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid

  calendarId String @map("calendar_id") @db.Uuid
  dayOfWeek  Int    @map("day_of_week")
  fromTime   String @map("from_time") // 'HH:mm'
  toTime     String @map("to_time") // 'HH:mm'

  calendar BusinessCalendar @relation(fields: [tenantId, calendarId], references: [tenantId, id])

  @@unique([tenantId, calendarId, dayOfWeek, fromTime])
  @@map("calendar_working_hours")
}

/// Ngày nghỉ — lễ dương recurring theo (tháng, ngày); Tết/Giỗ Tổ (âm lịch)
/// seed NGÀY CỤ THỂ theo năm (đã chốt 2026-08-07: seed data, không lib âm lịch).
