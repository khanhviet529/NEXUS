/// [REF] Tenancy: TENANT · Base: Business · aggregate root — máy trạng thái §4.7
model Order {
  // [TenantAuditedBase]
  id          String    @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  // [BusinessEntityBase]
  orgUnitId   String?   @map("org_unit_id") @db.Uuid
  version     Int       @default(1)
  externalId  String?   @map("external_id")
  source      String?
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  code          String // ORD-2026-00001 — document_sequences (§4.7)
  customerId    String    @map("customer_id") @db.Uuid
  status        String    @default("DRAFT") // state machine (packages/shared)
  currency      String    @default("VND")
  // Tiền là DECIMAL, API trả CHUỖI (§3.7). Kết quả từ bộ tính tiền B1
  subtotal      Decimal   @default(0) @db.Decimal(18, 2)
  discountTotal Decimal   @default(0) @map("discount_total") @db.Decimal(18, 2)
  taxTotal      Decimal   @default(0) @map("tax_total") @db.Decimal(18, 2)
  total         Decimal   @default(0) @db.Decimal(18, 2)
  margin        Decimal?  @db.Decimal(18, 2) // field-level group cost (matrix §4)
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz
  approvedById  String?   @map("approved_by_id") @db.Uuid

  // Composite FK §6.4 — order của tenant A không trỏ được customer của B
  customer Customer    @relation(fields: [tenantId, customerId], references: [tenantId, id])
  items    OrderItem[]

  @@unique([tenantId, id]) // đích composite FK cho items
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@map("orders")
}

/// [REF] Tenancy: TENANT · CHILD của aggregate (#47): TenantAuditedBase,
