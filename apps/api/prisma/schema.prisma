/// [CORE] File trên S3/MinIO qua presigned URL (§2, matrix §2.5).
/// Object key BẮT BUỘC tiền tố <tenantId>/ (§4.6). Row chỉ tạo SAU khi client
/// PUT xong và gọi confirm (server HeadObject xác minh) — không cần cột status.
/// Tenancy: TENANT · Base: Tenant · +SoftDelete
model File {
  // [TenantAuditedBase]
  id          String   @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  // [+SoftDelete]
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  bucket       String
  objectKey    String  @map("object_key")
  filename     String
  mime         String
  size         Int // bytes — đủ tới 2GB; file admin app không vượt (nếu vượt: đổi BigInt + DTO chuỗi)
  checksum     String?
  uploadedById String? @map("uploaded_by_id") @db.Uuid

  attachments Attachment[]

  @@unique([tenantId, id]) // đích composite FK (§6.4)
  @@unique([tenantId, objectKey])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("files")
}

/// [CORE] Đính file vào bản ghi — quan hệ đa hình (entity, entity_id), POLY erd.md.
/// Quyền đọc KẾ THỪA entity gốc (matrix §2.5) — không có quyền riêng.
/// Tenancy: TENANT · Base: Tenant
model Attachment {
  // [TenantAuditedBase]
  id          String   @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
