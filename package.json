{
  "name": "nexus",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "node tools/setup.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "gen:api": "turbo run gen:api",
    "gen:module": "plop --plopfile tools/generator/plopfile.mjs module",
    "check:architecture": "node tools/checks/run-all.mjs"
  },
  "devDependencies": {
    "plop": "^4.0.5",
    "turbo": "^2.10.8"
  }
}
