import { Body, Controller, Get, HttpCode, Param, ParseUUIDPipe, Post, Query } from '@nestjs/common';
import { ApiOperation, ApiProperty, ApiPropertyOptional, ApiTags } from '@nestjs/swagger';
import { Type } from 'class-transformer';
{{#if i18n}}
import { IsInt, IsNotEmptyObject, IsObject, IsOptional, IsString, Max, Min, MinLength } from 'class-validator';
{{else}}
import { IsInt, IsOptional, IsString, Max, Min, MinLength } from 'class-validator';
{{/if}}
import { AUDIT_ACTIONS } from '@nexus/shared';
import { RequirePermission } from '../../common/decorators/require-permission.decorator';
import { CurrentUser, type AuthUser } from '../../common/decorators/current-user.decorator';
import { AppException } from '../../common/errors/app.exception';
import { buildMeta } from '../../common/dto/paginated.dto';
{{#if i18n}}
import { resolveLocalizedValue, type Locale, type LocalizedText } from '../../common/query/localized';
import { RequestContextService } from '../../infra/cls/request-context';
{{/if}}
import { AbilityService } from '../auth/ability.service';
import { AuditRepository } from '../audit/audit.repository';
import { {{plural (pascalCase name)}}Repository } from './{{plural (dashCase name)}}.repository';

class Create{{pascalCase name}}Dto {
  @ApiProperty({ example: '{{constantCase name}}-001' })
  @IsString()
  @MinLength(1)
  code!: string;

{{#if i18n}}
  @ApiProperty({ example: { vi: 'Tên tiếng Việt' } })
  @IsObject()
  @IsNotEmptyObject()
  name!: LocalizedText;
{{else}}
  @ApiProperty({ example: 'Tên bản ghi' })
  @IsString()
  @MinLength(1)
  name!: string;
{{/if}}
}

class List{{plural (pascalCase name)}}Dto {
  @ApiPropertyOptional({ default: 1 })
  @IsOptional()
  @Type(() => Number)
  @IsInt()
  @Min(1)
  page: number = 1;

  @ApiPropertyOptional({ default: 20, maximum: 100 })
  @IsOptional()
  @Type(() => Number)
  @IsInt()
  @Min(1)
  @Max(100)
  limit: number = 20;
}

/**
 * [GEN] {{plural (pascalCase name)}} — khuôn [REF] orders: @RequirePermission MỌI route
 * (check #5 quét), row-level scope NHÚNG VÀO WHERE (§4.4 — list scopeWhere,
 * detail findInScope, KHÔNG lọc sau khi query), audit MỌI đường ghi (§4.9).
 * TODO sau khi sinh: filter/sort whitelist qua QueryConfig (khuôn products).
 */
@ApiTags('{{plural (dashCase name)}}')
@Controller('{{plural (dashCase name)}}')
export class {{plural (pascalCase name)}}Controller {
  constructor(
    private readonly repo: {{plural (pascalCase name)}}Repository,
    private readonly audit: AuditRepository,
{{#if i18n}}
    private readonly ctx: RequestContextService,
{{/if}}
    private readonly ability: AbilityService,
  ) {}

  private async scopeWhere(user: AuthUser, permission: string) {
    const ability = await this.ability.forUser(user);
    return ability.scopeWhere(permission);
  }

  @Get()
  @RequirePermission('{{dashCase name}}:read')
  @ApiOperation({ summary: 'Danh sách — NHỚ viết test đếm query (#12)' })
  async list(@CurrentUser() user: AuthUser, @Query() query: List{{plural (pascalCase name)}}Dto) {
    const scopeWhere = await this.scopeWhere(user, '{{dashCase name}}:read');
    const [data, total] = await this.repo.list({
      scopeWhere,
      page: query.page,
      limit: query.limit,
    });
{{#if i18n}}
    const locale = this.ctx.locale as Locale;
{{/if}}
    return {
      data: data.map((row) => ({
        id: row.id,
        code: row.code,
{{#if i18n}}
        name: resolveLocalizedValue(row.name, locale),
{{else}}
        name: row.name,
{{/if}}
        createdAt: row.createdAt,
      })),
      meta: buildMeta(query.page, query.limit, total),
    };
  }

  @Get(':id')
  @RequirePermission('{{dashCase name}}:read')
  async detail(@CurrentUser() user: AuthUser, @Param('id', ParseUUIDPipe) id: string) {
    const scopeWhere = await this.scopeWhere(user, '{{dashCase name}}:read');
    const row = await this.repo.findInScope(scopeWhere, id);
    if (!row) throw new AppException('COMMON.NOT_FOUND'); // ngoài scope = 404, chống IDOR (§4.10)
    return {
      id: row.id,
      code: row.code,
{{#if i18n}}
      name: resolveLocalizedValue(row.name, this.ctx.locale as Locale),
{{else}}
      name: row.name,
{{/if}}
      createdAt: row.createdAt,
    };
  }

  @Post()
  @HttpCode(201)
  @RequirePermission('{{dashCase name}}:create')
  async create(@CurrentUser() user: AuthUser, @Body() dto: Create{{pascalCase name}}Dto) {
    const row = await this.repo.create({
      tenantId: user.tenantId,
      createdById: user.sub,
      code: dto.code,
      name: dto.name,
    });
    // ADR-0004: action LẤY TỪ REGISTRY (không chuỗi tự do — timeline §4.9 phải
    // đọc được). Có transaction nghiệp vụ → chuyển sang audit.writeInTx(tx, …)
    // trong repository để audit cùng sống cùng chết với write (test #31).
    await this.audit.write({
      tenantId: user.tenantId,
      entity: '{{pascalCase name}}',
      entityId: row.id,
      action: AUDIT_ACTIONS.CREATE,
      after: { code: row.code },
    });
    return { id: row.id, code: row.code };
  }
}
