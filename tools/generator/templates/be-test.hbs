import { describe, it, expect, beforeAll, afterAll } from 'vitest';
import request from 'supertest';
import { createTestApp, type TestHarness } from './setup/test-app';

/**
 * [GEN] Test khung cho {{plural (dashCase name)}} — HOÀN THIỆN trước khi coi là xong:
 * - Ma trận quyền (#8): thêm dòng vào permission-matrix.spec.ts
 * - Đếm query (#12): endpoint list PHẢI có expectQueryCount
 * - Fixture BẮT BUỘC 2 tenant (§8.3)
 */
describe('{{plural (pascalCase name)}} — CRUD + cách ly tenant', () => {
  let h: TestHarness;
  const agent = () => request(h.app.getHttpServer());
  let adminToken = '';
  let adminBToken = '';

  beforeAll(async () => {
    h = await createTestApp();
    adminToken = await h.login('admin@tenant-a.local');
    adminBToken = await h.login('admin@tenant-b.local');
  });
  afterAll(async () => {
    await h.close();
  });

  it('tạo + đọc trong tenant A; tenant B KHÔNG thấy (§8.2 #1)', async () => {
    const create = await agent()
      .post('/api/v1/{{plural (dashCase name)}}')
      .set('Authorization', `Bearer ${adminToken}`)
      .send({ code: '{{constantCase name}}-T1', name: {{#if i18n}}{ vi: 'Bản ghi thử' }{{else}}'Bản ghi thử'{{/if}} });
    expect(create.status, JSON.stringify(create.body)).toBe(201);

    const listA = await agent()
      .get('/api/v1/{{plural (dashCase name)}}')
      .set('Authorization', `Bearer ${adminToken}`);
    expect(listA.body.data.map((r: { code: string }) => r.code)).toContain('{{constantCase name}}-T1');

    const listB = await agent()
      .get('/api/v1/{{plural (dashCase name)}}')
      .set('Authorization', `Bearer ${adminBToken}`);
    expect(listB.body.data.map((r: { code: string }) => r.code)).not.toContain('{{constantCase name}}-T1');

    // id của tenant A với token tenant B → 404, không phải 200/403 (IDOR §4.10)
    const crossDetail = await agent()
      .get(`/api/v1/{{plural (dashCase name)}}/${create.body.id}`)
      .set('Authorization', `Bearer ${adminBToken}`);
    expect(crossDetail.status).toBe(404);
  });
});
