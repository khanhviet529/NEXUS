# ============================================================
# .env.example — LUÔN đầy đủ (spec §9). Copy thành .env rồi sửa.
# apps/api validate bằng zod lúc khởi động — thiếu biến là crash ngay.
# ============================================================

NODE_ENV=development

# --- API ---
API_PORT=4000
API_BASE_URL=http://localhost:4000

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- PostgreSQL ---
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nexus
S3_SECRET_KEY=nexus-minio
S3_BUCKET=nexus
S3_REGION=us-east-1

# --- SMTP (mailpit ở dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@nexus.local

# --- Auth ---
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_min_32_bytes_random
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- CSRF / CORS ---
# Origin allowlist, ngăn bằng dấu phẩy (spec §4.3b)
ALLOWED_ORIGINS=http://localhost:3000

# --- Mã hoá secret tầng ứng dụng (spec §4.11) ---
# AES-256-GCM key, base64 của 32 byte. KHÔNG commit giá trị thật.
APP_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
APP_ENCRYPTION_KEY_VERSION=1
