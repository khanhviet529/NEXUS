# Tên dự án Docker Compose. ĐỔI GIÁ TRỊ NÀY nếu bạn clone repo lần thứ hai
# trên cùng một máy — để nguyên thì hai clone dùng chung container và DATABASE,
# và clone sau sẽ ghi đè dữ liệu của clone trước (F-04, docs/SWEEP-REPORT.md).
COMPOSE_PROJECT_NAME=nexus-dev

# Cổng host. Đổi CẢ CỤM khi chạy clone thứ hai — đổi COMPOSE_PROJECT_NAME thôi
# là KHÔNG đủ: nó tách container và volume, nhưng hai clone vẫn giành cùng cổng
# host và clone thứ hai chết ở "port is already allocated".
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ============================================================
# .env.example — LUÔN đầy đủ (spec §9). Copy thành .env rồi sửa.
# apps/api validate bằng zod lúc khởi động — thiếu biến là crash ngay.
# ============================================================

NODE_ENV=development

# --- API ---
API_PORT=4000
API_BASE_URL=http://localhost:4000

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- PostgreSQL ---
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nexus
S3_SECRET_KEY=nexus-minio
S3_BUCKET=nexus
S3_REGION=us-east-1

# --- SMTP (mailpit ở dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@nexus.local

# --- Auth ---
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Giá trị dev, ĐỦ DÀI để qua validator (F-16: bản cũ 29 ký tự, API không
# khởi động nổi sau bootstrap). Production dùng lại chuỗi này → API từ chối
# chạy, xem apps/api/src/config/env.ts.
JWT_SECRET=dev-only-KHONG-DUNG-O-PRODUCTION-0000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- CSRF / CORS ---
# Origin allowlist, ngăn bằng dấu phẩy (spec §4.3b)
ALLOWED_ORIGINS=http://localhost:3000

# --- Mã hoá secret tầng ứng dụng (spec §4.11) ---
# AES-256-GCM key, base64 của 32 byte. KHÔNG commit giá trị thật.
APP_ENCRYPTION_KEY=ZGV2LW9ubHkta2hvbmctZHVuZy1wcm9kLTAwMDA=
APP_ENCRYPTION_KEY_VERSION=1

# --- Giám sát (spec §9) — bỏ trống ở dev thì Sentry KHÔNG khởi tạo ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Gắn vào image lúc build; hiện ở /health và trong Sentry release
BUILD_VERSION=dev
